function [Ua] = invertAddierer(Ui, R);
    % kontrollieren, ob R ein Spaltenvektor ist
    if ~iscolumn(R)
        error("Die Dimensionen stimmen nicht überein!");
    end

    % kontrollieren, ob die Anzahl der Zeilen von Ui un R stimmt
    if ((size(Ui, 1) + 1) ~= size(R, 1))
        error("Die Dimensionen stimmen nicht überein!")
    end
    
    Ua = zeros(ndims(Ui))' .* zeros(ndims(Ui));

    Rn = R(ndims(R));

    for n = ndims(Ui)
        
    end


end